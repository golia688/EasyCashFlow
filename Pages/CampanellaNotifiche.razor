@using MudBlazor
@using EasyCashFlow.Services
@inject NotificheService Notifiche
@inject ImpostazioniService Impostazioni
@implements IDisposable

@* La campanella nella barra in alto (dal 05/11): il numero delle notifiche e, cliccando, l'elenco con un
   pulsante per ognuna. Le notifiche le raccoglie NotificheService; il pulsante lo esegue Main.razor. *@
<MudTooltip Text="@(Notifiche.Elenco.Count == 0 ? "Notifiche: nessuna" : $"Notifiche: {Notifiche.Elenco.Count}")">
    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" ListClass="pa-0" PopoverClass="menu-notifiche"
             OpenChanged="AlCambioApertura">
        <ActivatorContent>
            <MudBadge Content="Notifiche.Elenco.Count" Visible="Notifiche.Elenco.Count > 0" Overlap="true" Dot="false"
                      Color="ColoreBadge" Bordered="true">
                <MudIconButton Icon="@Impostazioni.Icona(Notifiche.Elenco.Count > 0 ? nameof(Icons.Material.Filled.Notifications) : nameof(Icons.Material.Filled.NotificationsNone))"
                               Color="Color.Inherit" aria-label="Notifiche" />
            </MudBadge>
        </ActivatorContent>
        <ChildContent>
            <div class="elenco-notifiche">
                <MudText Typo="Typo.subtitle2" Class="px-4 pt-3 pb-2">Notifiche</MudText>
                <MudDivider />
                @if (Notifiche.Elenco.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="pa-4 mud-text-secondary">Nessuna notifica: è tutto a posto.</MudText>
                }
                @foreach (var n in Notifiche.Elenco)
                {
                    <div class="notifica">
                        <MudIcon Icon="@Icona(n.Gravita)" Color="@Colore(n.Gravita)" Size="Size.Small" Class="mt-1" />
                        <div class="testo-notifica">
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@n.Titolo</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@n.Testo</MudText>
                            <MudStack Row="true" Spacing="1" Class="mt-1">
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                                           OnClick="() => Esegui.InvokeAsync(n)">@n.Pulsante</MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default"
                                           OnClick="() => Notifiche.Nascondi(n.Id)">Nascondi</MudButton>
                            </MudStack>
                        </div>
                    </div>
                }
                @if (Notifiche.Elenco.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="d-block px-4 pb-3 mud-text-secondary">
                        Una notifica sparisce da sola quando è risolta. "Nascondi" vale fino alla chiusura del programma.
                    </MudText>
                }
            </div>
        </ChildContent>
    </MudMenu>
</MudTooltip>

<style>
    .elenco-notifiche {
        width: 380px;
        max-height: 70vh;
        overflow-y: auto;
    }

    .notifica {
        display: flex;
        gap: 12px;
        padding: 12px 16px 8px;
        border-bottom: 1px solid var(--mud-palette-divider);
    }

    .testo-notifica {
        flex: 1;
        min-width: 0;
    }
</style>

@code {
    /// <summary>Il pulsante di una notifica (importare, aprire una pagina, rivedere un riepilogo).</summary>
    [Parameter] public EventCallback<Notifica> Esegui { get; set; }

    private Color ColoreBadge =>
        Notifiche.Elenco.Any(n => n.Gravita == GravitaNotifica.Errore) ? Color.Error
        : Notifiche.Elenco.Any(n => n.Gravita == GravitaNotifica.Avviso) ? Color.Warning
        : Color.Info;

    private string Icona(GravitaNotifica g) => g switch
    {
        GravitaNotifica.Errore => Impostazioni.Icona(nameof(Icons.Material.Filled.ErrorOutline)),
        GravitaNotifica.Avviso => Impostazioni.Icona(nameof(Icons.Material.Filled.WarningAmber)),
        _ => Impostazioni.Icona(nameof(Icons.Material.Filled.Info))
    };

    private static Color Colore(GravitaNotifica g) => g switch
    {
        GravitaNotifica.Errore => Color.Error,
        GravitaNotifica.Avviso => Color.Warning,
        _ => Color.Info
    };

    protected override void OnInitialized()
    {
        Notifiche.Cambiate += OnCambiate;
        Notifiche.Aggiorna();
    }

    // aprendo l'elenco si rileggono i numeri, che possono essere cambiati in una pagina (un gruppo salvato…)
    private void AlCambioApertura(bool aperto)
    {
        if (aperto) Notifiche.Aggiorna();
    }

    private void OnCambiate() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Notifiche.Cambiate -= OnCambiate;
}
