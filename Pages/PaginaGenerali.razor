@using MudBlazor
@using EasyCashFlow.Models
@using EasyCashFlow.Services
@inject PreferenzeService Preferenze
@inject ImpostazioniService Impostazioni
@inject DatabaseService Database

@* Impostazioni > Preferenze > Generali: pagina iniziale, conto e periodo proposti, conservazione dei log.
   Le prime tre stanno nel database cifrato (PreferenzeService), i giorni dei log in preferenze.json
   (ImpostazioniService), perché servono all'avvio prima della password. *@

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
    <MudText Typo="Typo.h4">Generali</MudText>
    <AiutoManuale Capitolo="impostazioni" />
</MudStack>

<MudPaper Class="pa-4 mt-4" Elevation="1" Style="max-width: 720px">
    <MudText Typo="Typo.h6">Pagina iniziale</MudText>
    <MudText Typo="Typo.body2" Class="mt-1 mb-3 mud-text-secondary">
        La pagina che vedi dopo aver inserito la password.
    </MudText>
    <MudToggleGroup T="PaginaIniziale" Value="Preferenze.PaginaIniziale" ValueChanged="Preferenze.ImpostaPaginaIniziale"
                    SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" CheckMark="true">
        <MudToggleItem T="PaginaIniziale" Value="PaginaIniziale.Home" Text="Home" />
        <MudToggleItem T="PaginaIniziale" Value="PaginaIniziale.Movimenti" Text="Movimenti" />
        <MudToggleItem T="PaginaIniziale" Value="PaginaIniziale.Analisi" Text="Analisi" />
    </MudToggleGroup>
</MudPaper>

<MudPaper Class="pa-4 mt-4" Elevation="1" Style="max-width: 720px">
    <MudText Typo="Typo.h6">Filtri proposti</MudText>
    <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">
        Il conto è già scelto nei filtri di Movimenti e di Analisi, il periodo in Analisi e nella simulazione.
        Sono le scelte di partenza quando apri il programma: nelle pagine puoi sempre cambiarle.
    </MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" Class="mt-4">
        <div style="width: 300px">
            <MudSelect T="string" Label="Conto" Value="@(Preferenze.ContoPredefinito ?? "")"
                       ValueChanged="@(c => Preferenze.ImpostaContoPredefinito(string.IsNullOrEmpty(c) ? null : c))"
                       ToStringFunc="NomeConto" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string" Value="@("")">Tutti i conti</MudSelectItem>
                @foreach (var c in _conti)
                {
                    <MudSelectItem T="string" Value="@c.Codice">@c.Nome</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div style="width: 300px">
            <MudSelect T="string" Label="Periodo" Value="@Preferenze.PeriodoPredefinito"
                       ValueChanged="Preferenze.ImpostaPeriodoPredefinito" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var p in PreferenzeService.PeriodiPossibili)
                {
                    <MudSelectItem T="string" Value="@p">@p</MudSelectItem>
                }
            </MudSelect>
        </div>
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4 mt-4" Elevation="1" Style="max-width: 720px">
    <MudText Typo="Typo.h6">Log</MudText>
    <MudText Typo="Typo.body2" Class="mt-1 mb-3 mud-text-secondary">
        Il log è il diario di quello che fa il programma (cartella log, un file al giorno), senza importi,
        descrizioni né IBAN. I file più vecchi di così si cancellano da soli, all'avvio e appena cambi la scelta.
    </MudText>
    @* sei voci: con la spunta le etichette andrebbero a capo, la scelta si vede già dal colore *@
    <MudToggleGroup T="int" Value="Impostazioni.GiorniLog" ValueChanged="Impostazioni.ImpostaGiorniLog"
                    SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary">
        @foreach (var giorni in ImpostazioniService.GiorniLogPossibili)
        {
            <MudToggleItem T="int" Value="giorni" Text="@TestoGiorni(giorni)" />
        }
    </MudToggleGroup>
</MudPaper>

@code {
    private List<ContoCorrente> _conti = [];

    protected override void OnInitialized() => _conti = Database.ElencoConti();

    // un conto predefinito che non c'è più vale come "tutti"
    private string NomeConto(string? codice) =>
        _conti.FirstOrDefault(c => c.Codice == codice)?.Nome ?? "Tutti i conti";

    private static string TestoGiorni(int giorni) => giorni switch
    {
        7 => "1 settimana",
        365 => "1 anno",
        30 => "1 mese",
        _ => $"{giorni / 30} mesi"      // 60, 90, 180
    };
}
