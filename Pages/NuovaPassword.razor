@using MudBlazor
@using EasyCashFlow.Services
@inject ImpostazioniService Impostazioni

@* Scelta di una password nuova: campo con "mostra", indicatore di robustezza, "Suggerisci una frase",
   ripetizione e pulsante. Lo usano PaginaAccesso (creazione, password nuova dopo il recupero) e
   PaginaSicurezza (cambio password). Il pulsante si abilita solo con una password accettabile e ripetuta
   uguale; la password scelta arriva a Confermato. *@

<MudTextField T="string" @bind-Value="_password" Immediate="true" AutoFocus="@AutoFocus" Class="mt-4"
              Label="@Etichetta" InputType="@(_mostra ? InputType.Text : InputType.Password)"
              Adornment="Adornment.End" AdornmentIcon="@IconaMostra" OnAdornmentClick="() => _mostra = !_mostra"
              Variant="Variant.Outlined" Margin="@Margine" />
@{
    var livello = ConsigliPassword.Valuta(_password);
}
@if (!string.IsNullOrEmpty(_password))
{
    <MudProgressLinear Value="@((int)livello * 25)" Color="@ColoreLivello(livello)" Rounded="true" Size="Size.Small" Class="mt-2" />
    <MudText Typo="Typo.caption" Color="@ColoreLivello(livello)">@ConsigliPassword.Testo(livello)</MudText>
}
<MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-1"
           StartIcon="@Impostazioni.Icona(nameof(Icons.Material.Filled.AutoAwesome))" OnClick="Suggerisci">Suggerisci una frase</MudButton>
<MudTextField T="string" @bind-Value="_ripeti" Immediate="true" Class="mt-2"
              Label="@($"Ripeti la {Etichetta.ToLowerInvariant()}")" InputType="@(_mostra ? InputType.Text : InputType.Password)"
              Error="@(!string.IsNullOrEmpty(_ripeti) && _ripeti != _password)" ErrorText="Le due password non sono uguali"
              OnKeyUp="@(e => e.Key == "Enter" ? Conferma() : Task.CompletedTask)"
              Variant="Variant.Outlined" Margin="@Margine" />
@Messaggi
<MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="@LargoQuantoIlRiquadro" Class="mt-4"
           Disabled="@(!Pronta)" OnClick="Conferma">@TestoPulsante</MudButton>

@code {
    [Parameter, EditorRequired] public string TestoPulsante { get; set; } = "";

    [Parameter] public EventCallback<string> Confermato { get; set; }

    /// <summary>Errori o avvisi da mostrare sopra il pulsante.</summary>
    [Parameter] public RenderFragment? Messaggi { get; set; }

    [Parameter] public string Etichetta { get; set; } = "Password";

    [Parameter] public bool AutoFocus { get; set; } = true;

    [Parameter] public bool LargoQuantoIlRiquadro { get; set; } = true;

    [Parameter] public Margin Margine { get; set; } = Margin.Normal;

    private string? _password;
    private string? _ripeti;
    private bool _mostra;

    private bool Pronta => ChiaviService.PasswordAccettabile(_password) && _password == _ripeti;

    private string IconaMostra => Impostazioni.Icona(_mostra ? nameof(Icons.Material.Filled.VisibilityOff) : nameof(Icons.Material.Filled.Visibility));

    private static Color ColoreLivello(ConsigliPassword.Livello livello) => livello switch
    {
        ConsigliPassword.Livello.TroppoCorta or ConsigliPassword.Livello.Debole => Color.Error,
        ConsigliPassword.Livello.Discreta => Color.Warning,
        _ => Color.Success
    };

    // la frase si mostra in chiaro, perché l'utente deve leggerla e ricordarla; va riscritta nel secondo campo
    private void Suggerisci()
    {
        _password = ConsigliPassword.SuggerisciFrase();
        _ripeti = null;
        _mostra = true;
    }

    private async Task Conferma()
    {
        if (!Pronta) return;
        await Confermato.InvokeAsync(_password!);
    }

    /// <summary>Svuota i campi (dopo un cambio riuscito).</summary>
    public void Svuota()
    {
        _password = _ripeti = null;
        _mostra = false;
        StateHasChanged();
    }
}
