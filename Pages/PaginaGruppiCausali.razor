@using System.Globalization
@using MudBlazor
@using EasyCashFlow.Models
@using EasyCashFlow.Services
@inject DatabaseService Database
@inject ISnackbar Snackbar
@inject ImpostazioniService Impostazioni
@inject SelettoreFile Selettore
@inject IDialogService Dialoghi
@inject LogService Log

@* Gruppi di causali (dal 10/11 per causale CBI): il gruppo si sceglie per le prime due cifre della causale,
   uguali per tutte le banche, e vale per tutte le causali che cominciano con quel codice. Fino al 09/11 si
   sceglieva per ogni causale completa di 4 caratteri.
   La freccia indietro c'è solo se la pagina si è aperta dalla Home o dal menu Dati di Movimenti (Main.razor). *@
<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
    @if (TornaIndietro.HasDelegate)
    {
        <MudTooltip Text="@TestoRitorno">
            <MudIconButton Icon="@Impostazioni.Icona(nameof(Icons.Material.Filled.ArrowBack))" OnClick="() => TornaIndietro.InvokeAsync()" />
        </MudTooltip>
    }
    <MudText Typo="Typo.h4">Gruppi di causali</MudText>
    <AiutoManuale Capitolo="gruppi" />
    <MudSpacer />
    @* i gruppi in un file, per ritrovarli su un'installazione nuova o su un altro computer (dal 06/11) *@
    <MudTooltip Text="Salva in un file i gruppi delle causali CBI">
        <MudButton Variant="Variant.Outlined" StartIcon="@Impostazioni.Icona(nameof(Icons.Material.Filled.FileDownload))"
                   OnClick="Esporta">Esporta</MudButton>
    </MudTooltip>
    <MudTooltip Text="Riprendi i gruppi da un file esportato prima">
        <MudButton Variant="Variant.Outlined" StartIcon="@Impostazioni.Icona(nameof(Icons.Material.Filled.FileUpload))"
                   OnClick="Importa">Importa</MudButton>
    </MudTooltip>
</MudStack>

<MudPaper Class="pa-4 mt-4" Elevation="1">
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Nelle analisi i movimenti si raggruppano per <b>causale CBI</b>: le prime due cifre della causale, un codice
        dello standard CBI uguale per tutte le banche (48 è un bonifico ricevuto, 43 un pagamento con il POS, 27 lo
        stipendio). Il gruppo che scegli per una causale CBI vale per tutti i movimenti con quel codice, di qualunque
        banca e di qualunque file. Per ogni causale CBI scegli:
    </MudText>
    <ul class="mud-typography-body2 mud-text-secondary mt-1 mb-3 ml-6">
        <li><b>Gruppo</b>: il nome che vedrai nei grafici, uno esistente o uno nuovo.</li>
        <li><b>Ordinario</b>: entrata o uscita vera e propria, secondo il segno del movimento.</li>
        <li><b>Investimento</b>: soldi spostati verso gli investimenti o rientrati da essi; non conta né come spesa né come entrata.</li>
        <li><b>Giroconto</b>: spostamento tra conti propri; escluso dalle analisi.</li>
        <li><b>Ricorrente</b>: spesa fissa, come mutuo, utenze e imposte; le altre sono variabili.</li>
    </ul>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Le causali CBI senza gruppo nelle analisi finiscono in "Altro". Un movimento diverso dagli altri della sua
        causale (per esempio un bonifico verso un tuo altro conto) si corregge da solo, dal menu ⋮ in Movimenti.
        Con <b>Esporta</b> salvi i gruppi in un file, e con <b>Importa</b> li ritrovi su un'installazione nuova.
    </MudText>
</MudPaper>

<MudPaper Class="pa-4 mt-4" Elevation="1">
    <TabellaCausaliCbi @ref="_tabella" ApriDettaglio="ApriDettaglio" />
</MudPaper>

@code {
    [Parameter] public EventCallback<(Indicatore Indicatore, string Gruppo)> ApriDettaglio { get; set; }

    /// <summary>Solo se la pagina si è aperta dalla Home o dai movimenti: mostra la freccia per tornarci.</summary>
    [Parameter] public EventCallback TornaIndietro { get; set; }

    [Parameter] public string TestoRitorno { get; set; } = "Torna indietro";

    private TabellaCausaliCbi? _tabella;

    private async Task Esporta()
    {
        var percorso = await Selettore.ScegliDoveSalvareGruppiAsync(FileGruppiCausali.NomeFile(DateTime.Now));
        if (percorso is null) return;
        try
        {
            var gruppi = Database.TuttiGruppiCausali();
            FileGruppiCausali.Scrivi(percorso, gruppi);
            Log.Info($"Gruppi di causali esportati: {gruppi.Count} causali CBI in {System.IO.Path.GetFileName(percorso)}");
            Snackbar.Add($"Esportati i gruppi di {gruppi.Count} causali CBI in {System.IO.Path.GetFileName(percorso)}.", Severity.Success);
        }
        catch (Exception ex) when (ex is System.IO.IOException or UnauthorizedAccessException)
        {
            Log.Errore("Esportazione dei gruppi di causali non riuscita", ex);
            Snackbar.Add($"Il file non è stato salvato: {ex.Message}", Severity.Error);
        }
    }

    // Legge il file, mostra cosa cambierebbe e scrive solo dopo la conferma. Le causali CBI del file
    // sostituiscono gruppo, tipo e ricorrenza; quelle che il file non ha restano come sono.
    private async Task Importa()
    {
        var percorso = await Selettore.ScegliFileGruppiAsync();
        if (percorso is null) return;

        FileGruppiLetto letto;
        try
        {
            letto = FileGruppiCausali.Leggi(percorso);
        }
        catch (Exception ex) when (ex is System.IO.InvalidDataException or System.IO.IOException or UnauthorizedAccessException)
        {
            Log.Errore($"Importazione dei gruppi di causali da {System.IO.Path.GetFileName(percorso)} non riuscita", ex);
            Snackbar.Add(ex is System.IO.InvalidDataException ? ex.Message : $"Il file non si può leggere: {ex.Message}",
                         Severity.Error, o => o.RequireInteraction = true);
            return;
        }

        if (letto.Gruppi.Count == 0)
        {
            Snackbar.Add("Il file non contiene nessun gruppo di causale valido: non è cambiato niente.", Severity.Warning);
            return;
        }

        // causale CBI per causale CBI: com'è adesso e com'è nel file
        var attuali = Database.TuttiGruppiCausali().ToDictionary(g => g.Causale);
        var cambiano = new List<(GruppoEsportato Attuale, GruppoEsportato Nuovo)>();
        var nuove = new List<GruppoEsportato>();
        foreach (var g in letto.Gruppi.OrderBy(g => g.Causale, StringComparer.Ordinal))
        {
            if (!attuali.TryGetValue(g.Causale, out var a))
                nuove.Add(g);
            else if (a.Gruppo != g.Gruppo || a.Tipo != g.Tipo || a.Ricorrente != g.Ricorrente)
                cambiano.Add((a, g));
        }
        var uguali = letto.Gruppi.Count - nuove.Count - cambiano.Count;

        if (nuove.Count + cambiano.Count == 0)
        {
            Snackbar.Add($"Le {letto.Gruppi.Count} causali CBI del file hanno già gli stessi gruppi: non c'è niente da cambiare." +
                         (letto.Scarti.Count > 0 ? $" {letto.Scarti.Count} righe del file non erano valide." : ""), Severity.Info);
            return;
        }

        var parametri = new DialogParameters<DialogoImportaGruppi>
        {
            { d => d.NomeFile, System.IO.Path.GetFileName(percorso) },
            { d => d.EsportatoIl, letto.EsportatoIl },
            { d => d.Cambiano, cambiano },
            { d => d.Nuove, nuove },
            { d => d.Uguali, uguali },
            { d => d.Scarti, letto.Scarti }
        };
        var finestra = await Dialoghi.ShowAsync<DialogoImportaGruppi>("Importa i gruppi di causali", parametri,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });
        if (await finestra.Result is not { Canceled: false }) return;

        var esito = Database.ImportaGruppiCausali(letto.Gruppi);
        _tabella?.Carica();
        Snackbar.Add($"Gruppi importati: {esito.Nuove} causali CBI aggiunte, {esito.Cambiate} cambiate.", Severity.Success);
    }
}
