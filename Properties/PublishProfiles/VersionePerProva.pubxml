<?xml version="1.0" encoding="utf-8"?>
<!--
  Pubblicazione di una versione da far provare ad altri (Esplora soluzioni > EasyCashFlow > Pubblica).
  Crea una cartella autosufficiente: contiene .NET e la parte web (wwwroot), non contiene dati né log.
  Va zippata e spedita così com'è. Prima di pubblicare, aumentare <Version> nel .csproj.

  Scelte:
  - Autonoma (SelfContained): chi la riceve non deve installare .NET. La cartella è più grande.
  - Niente file singolo: con Blazor dentro WPF la parte web deve restare in file separati.
  - win-x64: Windows a 64 bit, cioè praticamente tutti i PC di oggi.
  - La cartella è sempre la stessa e viene svuotata a ogni pubblicazione (anche delle cartelle dati e
    log, se il programma è stato provato da lì): non usarla come cartella di lavoro. La versione nel
    nome della cartella non si può mettere: Visual Studio legge il profilo prima di <Version>, che
    risulterebbe vuota (la cartella si chiamava "EasyCashFlow-"). Dai la versione al nome dello zip.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <PublishDir>bin\Pubblicazione\EasyCashFlow\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>

  <!-- DeleteExistingFiles non basta: il 04/11 la cartella non era stata svuotata, e la copia "solo se
       piu' nuovo" di MSBuild aveva lasciato il SQLitePCLRaw.core.dll 2.1.13 della 0.9.2, che ha una data
       piu' recente del 3.0.2 richiesto dalla 0.9.3: il programma pubblicato non partiva. Qui la cartella
       si cancella davvero prima di ogni pubblicazione, da Visual Studio e da "dotnet publish". -->
  <Target Name="SvuotaCartellaPubblicazione" BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(PublishDir)" />
  </Target>
</Project>
