<Window x:Class="EasyCashFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:EasyCashFlow"
        Title="EasyCashFlow" Height="800" Width="1280"
        Icon="pack://application:,,,/Assets/easycashflow.ico">
    <Grid>
        <!-- Nascosta (non Collapsed) finché Blazor non ha disegnato la prima pagina: così si avvia
             comunque, ma non si vede vuota. La mostra MainWindow.MostraInterfaccia. -->
        <blazor:BlazorWebView x:Name="vistaBlazor" HostPage="wwwroot\index.html" Services="{DynamicResource services}"
                              Visibility="Hidden">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type local:Main}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>

        <!-- Schermata di avvio nativa: compare subito, mentre il browser interno e Blazor si avviano.
             Gli stessi elementi della schermata HTML di index.html, con colori leggibili su entrambi i temi. -->
        <StackPanel x:Name="schermataAvvio" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- il PNG a 256 px e non il .ico: dal .ico WPF prendeva un'immagine piccola (quella da 16 o 24 px,
                 con il solo euro) e la ingrandiva, sgranata e diversa dall'icona della barra delle applicazioni -->
            <Image Source="pack://application:,,,/Assets/easycashflow.png" Width="72" Height="72"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="EasyCashFlow" FontSize="22" Foreground="#8E8E99" Margin="0,16,0,0"
                       HorizontalAlignment="Center" FontFamily="Segoe UI" />
            <ProgressBar IsIndeterminate="True" Width="160" Height="4" Margin="0,16,0,0"
                         Foreground="#26A69A" Background="#408E8E99" BorderThickness="0" />
            <TextBlock x:Name="testoAvvio" Text="Avvio in corso…" FontSize="13" Foreground="#8E8E99"
                       Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center" FontFamily="Segoe UI" />
        </StackPanel>
    </Grid>
</Window>
